---
import type { CollectionEntry } from 'astro:content';
import Icono from './Icono.astro';
import { url, fecha } from '../lib/url';

interface Props {
  noticia: CollectionEntry<'noticias'>;
}
const { noticia } = Astro.props;
const { title, date, author, image, excerpt } = noticia.data;
const href = url(`/${noticia.id}/`);
const resumen = excerpt.length > 90 ? excerpt.slice(0, 90).replace(/\s+\S*$/, '') + '[…]' : excerpt;
---
<article class="noticia">
  <a class="noticia__imagen" href={href} tabindex="-1" aria-hidden="true">
    {image ? <img src={url(image)} alt="" loading="lazy" width="400" height="300" /> : <span class="noticia__sin-imagen"></span>}
  </a>
  <h3 class="noticia__titulo"><a href={href}>{title}</a></h3>
  <p class="noticia__meta">Escrito por <span>{author}</span> el <time datetime={date.toISOString().slice(0, 10)}>{fecha(date)}</time></p>
  {resumen && <p class="noticia__resumen">{resumen}</p>}
  <a class="noticia__mas" href={href}>Conocer más… <Icono nombre="flecha" size={14} /></a>
</article>

<style>
  .noticia { display: flex; flex-direction: column; }
  .noticia__imagen { display: block; aspect-ratio: 4 / 3; border-radius: 24px 24px 24px 0; overflow: hidden; background: #dad6da; margin-bottom: 1rem; }
  .noticia__imagen img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .noticia__imagen:hover img { transform: scale(1.04); }
  .noticia__sin-imagen { display: block; height: 100%; background: linear-gradient(135deg, var(--violeta), var(--violeta-claro)); }
  .noticia__titulo { font-size: 1.3rem; font-weight: 600; margin: 0 0 0.5rem; }
  .noticia__titulo a { color: var(--texto); text-decoration: none; }
  .noticia__titulo a:hover { color: var(--violeta); }
  .noticia__meta { margin: 0 0 0.75rem; font-size: 0.85rem; font-weight: 400; }
  .noticia__meta span, .noticia__meta time { color: var(--violeta); }
  .noticia__resumen { font-weight: 400; font-size: 0.95rem; }
  .noticia__mas {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
</style>
