---
/**
 * Formulario que envía los mensajes por mail usando Web3Forms (gratis, sin servidor).
 * La clave se carga en src/data/sitio.json -> formularios.web3forms_key
 * (o desde Pages CMS: "Configuración del sitio"). Mientras esté vacía, el formulario
 * avisa que no está configurado y ofrece escribir directo por mail.
 */
import sitio from '../data/sitio.json';

export interface Campo {
  nombre: string;
  etiqueta: string;
  tipo?: 'text' | 'email' | 'tel' | 'textarea' | 'select' | 'checkbox';
  requerido?: boolean;
  opciones?: string[];
  placeholder?: string;
  autocompletar?: string;
}

interface Props {
  id: string;
  asunto: string;
  campos: Campo[];
  boton?: string;
}

const { id, asunto, campos, boton = 'Enviar' } = Astro.props;
const clave = sitio.formularios?.web3forms_key?.trim() ?? '';
---
<form class="formulario" id={id} data-clave={clave} data-email={sitio.email} novalidate>
  <input type="hidden" name="subject" value={asunto} />
  <input type="hidden" name="from_name" value="Web SomosMa" />
  <input type="checkbox" name="botcheck" class="oculto" tabindex="-1" autocomplete="off" />

  {campos.map((c) =>
    c.tipo === 'checkbox' ? (
      <fieldset class="formulario__campo formulario__campo--grupo" data-requerido={c.requerido ? '1' : undefined} data-nombre={c.etiqueta}>
        <legend>{c.etiqueta}{c.requerido && '*'}</legend>
        <div class="formulario__opciones">
          {(c.opciones ?? []).map((o) => (
            <label class="formulario__opcion">
              <input type="checkbox" name={c.nombre} value={o} /> {o}
            </label>
          ))}
        </div>
      </fieldset>
    ) : (
      <label class:list={['formulario__campo', { 'formulario__campo--grupo': c.tipo === 'select' }]}>
        <span>{c.etiqueta}{c.requerido && '*'}</span>
        {c.tipo === 'textarea' ? (
          <textarea name={c.nombre} required={c.requerido} rows="10"></textarea>
        ) : c.tipo === 'select' ? (
          <select name={c.nombre} required={c.requerido}>
            <option value="">{c.placeholder ?? 'Seleccioná una opción'}</option>
            {(c.opciones ?? []).map((o) => <option value={o}>{o}</option>)}
          </select>
        ) : (
          <input type={c.tipo ?? 'text'} name={c.nombre} required={c.requerido} autocomplete={c.autocompletar} />
        )}
      </label>
    )
  )}

  <button class="boton" type="submit">{boton}</button>
  <p class="formulario__estado" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.formulario').forEach((form) => {
    if (form.dataset.listo) return;
    form.dataset.listo = '1';
    const estado = form.querySelector<HTMLElement>('.formulario__estado')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const mostrar = (tipo: 'ok' | 'error' | '', texto: string) => {
      estado.dataset.tipo = tipo;
      estado.textContent = texto;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // Grupos de casillas obligatorios: al menos una marcada
      for (const grupo of form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-requerido]')) {
        if (!grupo.querySelector('input:checked')) {
          mostrar('error', `Elegí al menos una opción en "${grupo.dataset.nombre}".`);
          grupo.querySelector('input')?.focus();
          return;
        }
      }
      const clave = form.dataset.clave;
      if (!clave) {
        mostrar('error', `El formulario todavía no está configurado. Escribinos a ${form.dataset.email}.`);
        return;
      }
      // Las casillas con el mismo nombre se envían juntas: "Mañana, Tarde"
      const datos: Record<string, string> = {};
      for (const [k, v] of new FormData(form).entries()) {
        const valor = String(v);
        datos[k] = datos[k] ? `${datos[k]}, ${valor}` : valor;
      }
      datos.access_key = clave;
      boton.disabled = true;
      mostrar('', 'Enviando…');
      try {
        const r = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(datos),
        });
        const res = await r.json();
        if (!r.ok || !res.success) throw new Error(res.message || 'Error');
        form.reset();
        mostrar('ok', '¡Gracias! Recibimos tu mensaje y te vamos a responder a la brevedad.');
      } catch {
        mostrar('error', `No pudimos enviar el mensaje. Probá de nuevo o escribinos a ${form.dataset.email}.`);
      } finally {
        boton.disabled = false;
      }
    });
  });
</script>
