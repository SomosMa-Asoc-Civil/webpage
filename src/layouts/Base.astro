---
import '../styles/global.css';
import sitio from '../data/sitio.json';
import IconoRed from '../components/IconoRed.astro';
import Icono from '../components/Icono.astro';
import IconoKubio from '../components/IconoKubio.astro';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
}

const { titulo, descripcion = sitio.descripcion, imagen = sitio.imagen_compartir, tipo = 'website' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} – ${sitio.nombre}` : `${sitio.nombre} – ${sitio.nombre_completo}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = imagen ? new URL(url(imagen), Astro.site).href : undefined;

const actual = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const esActual = (destino: string) =>
  destino === '/' ? actual === '/' : actual.startsWith(destino.replace(/\/$/, ''));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={url(sitio.favicon)} />
    <link rel="apple-touch-icon" href={url(sitio.favicon)} />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo || sitio.lema} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,900;1,400;1,700&family=Open+Sans:wght@600&family=Syne:wght@400&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="sr-only" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__barra">
        <a class="cabecera__logo" href={url('/')} aria-label={`${sitio.nombre} – inicio`}>
          <img src={url(sitio.logo)} alt={sitio.nombre} width="140" height="60" />
        </a>
        <button class="cabecera__toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
          <span class="sr-only">Abrir menú</span>
          <IconoKubio nombre="menu" size={30} />
        </button>
        <nav id="menu-principal" class="cabecera__menu" aria-label="Menú principal">
          <div class="panel__cabecera">
            <span class="panel__titulo">{sitio.nombre}</span>
            <button class="panel__cerrar sr-only" type="button">Cerrar menú</button>
          </div>
          <ul>
            {sitio.menu.map((item) => (
              <li>
                <a href={url(item.url)} aria-current={esActual(item.url) ? 'page' : undefined}>{item.texto}</a>
              </li>
            ))}
          </ul>
          <p class="panel__pie">© {new Date().getFullYear()} {sitio.nombre}</p>
        </nav>
        <div class="panel__fondo" aria-hidden="true"></div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__contenido">
        <div class="pie__marca">
          <a href={url('/')} aria-label={sitio.nombre}>
            <img class="pie__logo" src={url(sitio.logo)} alt={sitio.nombre} width="115" height="100" loading="lazy" />
          </a>
          <div class="pie__redes">
            {sitio.redes.filter((r) => r.en_pie).map((r) => (
              <a href={r.url} target="_blank" rel="noopener" aria-label={r.red}>
                <IconoRed red={r.red} size={26} />
              </a>
            ))}
            <a href={url(sitio.pie?.enlace_mail || `mailto:${sitio.email}`)} aria-label="Contacto"><IconoRed red="mail" size={26} /></a>
          </div>
        </div>
        <div class="pie__textos">
          <p class="pie__lema">{sitio.nombre_completo}. {sitio.lema}</p>
          <p class="pie__legal">
            © {new Date().getFullYear()} {sitio.nombre}.
            {sitio.credito?.texto && (
              <>
                {' '}·{' '}
                {sitio.credito.url ? (
                  <a class="pie__credito" href={sitio.credito.url} target="_blank" rel="noopener">{sitio.credito.texto}</a>
                ) : (
                  <span class="pie__credito">{sitio.credito.texto}</span>
                )}
              </>
            )}
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.cabecera__toggle');
      const menu = document.getElementById('menu-principal');
      const cabecera = document.querySelector('.cabecera');
      // Margen entre 10 y 90 px para que no "titile" al achicarse la barra
      const alScroll = () => {
        if (!cabecera) return;
        if (window.scrollY > 90) cabecera.classList.add('fija');
        else if (window.scrollY < 10) cabecera.classList.remove('fija');
      };
      alScroll();
      window.addEventListener('scroll', alScroll, { passive: true });
      // Menú lateral (celular y tablet)
      const abrir = (si: boolean) => {
        toggle?.setAttribute('aria-expanded', String(si));
        menu?.classList.toggle('abierto', si);
        document.body.classList.toggle('menu-abierto', si);
        if (si) menu?.querySelector<HTMLElement>('a')?.focus();
      };
      toggle?.addEventListener('click', () => abrir(toggle.getAttribute('aria-expanded') !== 'true'));
      document.querySelector('.panel__cerrar')?.addEventListener('click', () => abrir(false));
      document.querySelector('.panel__fondo')?.addEventListener('click', () => abrir(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') abrir(false); });
    </script>
  </body>
</html>

<style>
  /* Encabezado. Valores del menú de Kubio:
     arriba: fondo violeta, ítems #171948, hover y activo en blanco, subrayado amarillo de 5 px;
     al bajar: fondo blanco con sombra, ítems #302f30, hover violeta, activo #171948, subrayado rojo. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    --fondo: var(--violeta);
    --menu-texto: var(--azul-noche);
    --menu-hover: var(--blanco);
    --menu-actual: var(--blanco);
    --menu-subrayado: var(--amarillo);
    background: var(--fondo);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }
  .cabecera.fija {
    --fondo: var(--blanco);
    --menu-texto: var(--texto);
    --menu-hover: var(--violeta);
    --menu-actual: var(--azul-noche);
    --menu-subrayado: var(--rojo);
    box-shadow: 0 0 10px rgba(23, 25, 39, 0.1);
  }
  .cabecera__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 10px;
    min-height: 90px;
    transition: min-height 0.35s ease, padding 0.35s ease;
  }
  .cabecera__logo { display: block; flex: none; }
  .cabecera__logo img { height: 70px; width: auto; transition: height 0.35s ease; }
  .cabecera.fija .cabecera__barra { padding-block: 0; min-height: 72px; }
  .cabecera.fija .cabecera__logo img { height: 52px; }

  .cabecera__menu ul { display: flex; gap: 33px; list-style: none; margin: 0; padding: 0; }
  .cabecera__menu a {
    position: relative;
    display: block;
    padding: 10px 0;
    font-family: var(--fuente-titulos);
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 1px;
    color: var(--menu-texto);
    text-decoration: none;
    transition: color 0.3s;
  }
  /* Subrayado: en la página actual siempre visible; en hover crece desde el centro */
  .cabecera__menu a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 5px;
    background: var(--menu-subrayado);
    opacity: 0;
    transition: all 0.3s;
  }
  .cabecera__menu a:hover { color: var(--menu-hover); }
  .cabecera__menu a:hover::after,
  .cabecera__menu a[aria-current='page']::after { left: 0; width: 100%; opacity: 1; }
  .cabecera__menu a[aria-current='page'] { color: var(--menu-actual); }

  /* Escritorio: logo de 110 px como en Kubio */
  @media (min-width: 1024px) {
    .cabecera__barra { min-height: 130px; }
    .cabecera__logo img { height: 110px; }
    .cabecera.fija .cabecera__logo img { height: 80px; }
    .cabecera.fija .cabecera__barra { min-height: 90px; }
  }
  .cabecera__toggle { display: none; }

  .panel__cabecera, .panel__pie, .panel__fondo { display: none; }

  /* Celular y tablet: menú en panel lateral oscuro, como el de Kubio */
  @media (max-width: 1023px) {
    /* Ícono "bars" de Line Awesome: 30 px + 5 px de aire, #302f30; al pasar el mouse, rojo (1 s) */
    .cabecera__toggle {
      display: grid;
      place-items: center;
      padding: 5px;
      background: none;
      border: 0;
      color: var(--texto);
      cursor: pointer;
      transition: color 1s;
    }
    .cabecera__toggle:hover, .cabecera__toggle:focus-visible { color: var(--rojo); }
    .cabecera__toggle :global(svg) { width: 30px; height: 30px; }

    /* Panel del tema: 300 px, fondo #302f30, ítems 14 px con 20/40 px de relleno,
       hover y página actual en violeta */
    .cabecera__menu {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 102;
      height: 100dvh;
      width: 300px;
      max-width: 100vw;
      display: flex;
      flex-direction: column;
      background: #302f30;
      overflow-y: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.35s ease, visibility 0s linear 0.35s;
    }
    .cabecera__menu.abierto { transform: none; visibility: visible; transition: transform 0.35s ease; }

    .panel__cabecera { display: block; padding: 40px 25px 30px; }
    .panel__titulo { display: inline-block; padding: 10px; font-family: var(--fuente-titulos); font-weight: 700; font-size: 24px; line-height: 1.2; color: var(--blanco); }

    .cabecera__menu ul { flex-direction: column; gap: 0; padding: 0; }
    .cabecera__menu a {
      padding: 20px 20px 20px 40px;
      border: 0;
      color: var(--blanco);
      font-family: var(--fuente-titulos);
      font-weight: 500;
      font-size: 14px;
      line-height: 1.5;
      letter-spacing: 0;
      transition: background-color 0.3s;
    }
    .cabecera__menu a::after { display: none; }
    .cabecera__menu a:hover,
    .cabecera__menu a[aria-current='page'] { color: var(--blanco); background: var(--violeta); border: 0; }

    .panel__pie { display: block; margin: auto 0 0; padding: 30px 35px; color: rgba(255, 255, 255, 0.45); font-size: 16px; font-weight: 300; }

    .panel__fondo {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 101;
      background: rgba(0, 0, 0, 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }
    .cabecera__menu.abierto ~ .panel__fondo { opacity: 1; pointer-events: auto; }
  }

  /* Valores del pie de Kubio: fondo #f5b73c, 30 px arriba/abajo, logo 70 px, íconos 26 px */
  .pie { background: var(--amarillo); padding: 30px 0; }
  .pie__contenido { display: grid; justify-items: center; text-align: center; gap: 30px; }
  .pie__marca { display: grid; justify-items: center; gap: 30px; padding-top: 30px; }
  .pie__logo { height: 100px; width: auto; }
  .pie__redes { display: flex; gap: 15px; }
  .pie__redes a { color: var(--blanco); display: inline-flex; transition: color 1s; }
  .pie__redes a:hover { color: var(--rojo); }
  .pie__textos { display: grid; gap: 14px; padding-bottom: 30px; }
  .pie__textos p { margin: 0; }
  .pie__lema { font-family: var(--fuente-titulos); font-weight: 700; font-size: 16px; line-height: 1.6; color: var(--blanco); }
  .pie__legal { font-size: 14px; font-weight: 300; color: var(--texto); }
  .pie__credito { color: inherit; text-decoration: none; }
  a.pie__credito:hover { text-decoration: underline; }

  /* Escritorio: logo e íconos a la izquierda, textos a la derecha */
  @media (min-width: 1024px) {
    .pie__contenido { grid-template-columns: auto 1fr; justify-items: start; align-items: center; text-align: left; column-gap: 60px; }
    .pie__marca { grid-auto-flow: column; align-items: center; }
  }
</style>
