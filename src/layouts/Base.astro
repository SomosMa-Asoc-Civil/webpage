---
import '../styles/global.css';
import sitio from '../data/sitio.json';
import IconoRed from '../components/IconoRed.astro';
import Icono from '../components/Icono.astro';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
}

const { titulo, descripcion = sitio.descripcion, imagen = sitio.imagen_compartir, tipo = 'website' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} – ${sitio.nombre}` : `${sitio.nombre} – ${sitio.nombre_completo}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = imagen ? new URL(url(imagen), Astro.site).href : undefined;

const actual = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const esActual = (destino: string) =>
  destino === '/' ? actual === '/' : actual.startsWith(destino.replace(/\/$/, ''));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={url(sitio.favicon)} />
    <link rel="apple-touch-icon" href={url(sitio.favicon)} />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo || sitio.lema} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Roboto:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="sr-only" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__barra">
        <a class="cabecera__logo" href={url('/')} aria-label={`${sitio.nombre} – inicio`}>
          <img src={url(sitio.logo)} alt={sitio.nombre} width="140" height="60" />
        </a>
        <button class="cabecera__toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
          <span class="sr-only">Abrir menú</span>
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
        <nav id="menu-principal" class="cabecera__menu" aria-label="Menú principal">
          <div class="panel__cabecera">
            <span class="panel__titulo">{sitio.nombre}</span>
            <button class="panel__cerrar" type="button" aria-label="Cerrar menú">×</button>
          </div>
          <ul>
            {sitio.menu.map((item) => (
              <li>
                <a href={url(item.url)} aria-current={esActual(item.url) ? 'page' : undefined}>{item.texto}</a>
              </li>
            ))}
          </ul>
          <p class="panel__pie">© {new Date().getFullYear()} {sitio.nombre}</p>
        </nav>
        <div class="panel__fondo" aria-hidden="true"></div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__contenido">
        <a href={url('/')} aria-label={sitio.nombre}>
          <img class="pie__logo" src={url(sitio.logo)} alt={sitio.nombre} width="120" height="120" loading="lazy" />
        </a>
        <div class="pie__redes">
          {sitio.redes.map((r) => (
            <a href={r.url} target="_blank" rel="noopener" aria-label={r.red}>
              <IconoRed red={r.red} size={34} />
            </a>
          ))}
          <a href={`mailto:${sitio.email}`} aria-label="Mail"><Icono nombre="mail" size={34} /></a>
        </div>
        <p class="pie__lema">{sitio.nombre_completo}. {sitio.lema}</p>
        <p class="pie__legal">© {new Date().getFullYear()} {sitio.nombre}. <a href={`mailto:${sitio.email}`}>{sitio.email}</a></p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.cabecera__toggle');
      const menu = document.getElementById('menu-principal');
      const cabecera = document.querySelector('.cabecera');
      // Margen entre 10 y 90 px para que no "titile" al achicarse la barra
      const alScroll = () => {
        if (!cabecera) return;
        if (window.scrollY > 90) cabecera.classList.add('fija');
        else if (window.scrollY < 10) cabecera.classList.remove('fija');
      };
      alScroll();
      window.addEventListener('scroll', alScroll, { passive: true });
      // Menú lateral (celular y tablet)
      const abrir = (si: boolean) => {
        toggle?.setAttribute('aria-expanded', String(si));
        menu?.classList.toggle('abierto', si);
        document.body.classList.toggle('menu-abierto', si);
        if (si) menu?.querySelector<HTMLElement>('a')?.focus();
      };
      toggle?.addEventListener('click', () => abrir(toggle.getAttribute('aria-expanded') !== 'true'));
      document.querySelector('.panel__cerrar')?.addEventListener('click', () => abrir(false));
      document.querySelector('.panel__fondo')?.addEventListener('click', () => abrir(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') abrir(false); });
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    --fondo: var(--violeta);
    background: var(--fondo);
    transition: background 0.35s ease, box-shadow 0.35s ease;
    --menu-activo: var(--amarillo);
    --menu-texto: var(--azul-noche);
    --menu-texto-activo: var(--blanco);
  }
  /* Al bajar, la barra pasa a blanca con sombra (igual que el menú fijo de Kubio) */
  .cabecera.fija {
    --fondo: var(--blanco);
    box-shadow: 0 0 10px rgba(23, 25, 39, 0.1);
    --menu-activo: var(--rojo);
    --menu-texto: var(--texto);
    --menu-texto-activo: var(--texto);
  }
  .cabecera__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 144px;
    transition: min-height 0.35s ease;
  }
  .cabecera__logo img { height: 80px; width: auto; transition: height 0.35s ease; }
  /* Versión compacta al bajar */
  .cabecera.fija .cabecera__barra { min-height: 72px; }
  .cabecera.fija .cabecera__logo img { height: 52px; }
  .cabecera__menu ul { display: flex; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .cabecera__menu a {
    display: block;
    padding: 0.4rem 0.75rem;
    font-family: var(--fuente-titulos);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: var(--menu-texto);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .cabecera__menu a:hover { color: var(--menu-texto-activo); }
  .cabecera__menu a[aria-current='page'] { color: var(--menu-texto-activo); border-bottom-color: var(--menu-activo); }
  .cabecera__toggle { display: none; }

  .panel__cabecera, .panel__pie, .panel__fondo { display: none; }

  /* Celular y tablet: menú en panel lateral oscuro, como el de Kubio */
  @media (max-width: 1023px) {
    .cabecera__toggle {
      display: grid;
      gap: 6px;
      padding: 10px;
      background: none;
      border: 0;
      cursor: pointer;
    }
    .cabecera__toggle span[aria-hidden] { width: 34px; height: 2px; background: var(--azul-noche); border-radius: 2px; }
    .cabecera.fija .cabecera__toggle span[aria-hidden] { background: var(--texto); }

    .cabecera__menu {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 102;
      height: 100dvh;
      width: min(400px, 85vw);
      display: flex;
      flex-direction: column;
      background: #2f2f2f;
      overflow-y: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.35s ease, visibility 0s linear 0.35s;
    }
    .cabecera__menu.abierto { transform: none; visibility: visible; transition: transform 0.35s ease; }

    .panel__cabecera { display: flex; align-items: center; justify-content: space-between; padding: 3rem 2.5rem 2rem 3.25rem; }
    .panel__titulo { font-family: var(--fuente-titulos); font-weight: 700; font-size: 2rem; color: var(--blanco); }
    .panel__cerrar { background: none; border: 0; color: rgba(255, 255, 255, 0.7); font-size: 2.2rem; line-height: 1; cursor: pointer; }
    .panel__cerrar:hover { color: var(--blanco); }

    .cabecera__menu ul { flex-direction: column; gap: 0; padding: 0; }
    .cabecera__menu a {
      padding: 1.6rem 3.25rem;
      border: 0;
      color: var(--blanco);
      font-weight: 500;
      font-size: 1.15rem;
      letter-spacing: 0;
    }
    .cabecera__menu a:hover { color: var(--blanco); background: rgba(255, 255, 255, 0.06); }
    .cabecera__menu a[aria-current='page'] { color: var(--blanco); background: var(--violeta); }

    .panel__pie { display: block; margin: auto 0 0; padding: 2rem 2.5rem; color: #9b9b9b; font-size: 1.1rem; }

    .panel__fondo {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 101;
      background: rgba(0, 0, 0, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }
    .cabecera__menu.abierto ~ .panel__fondo { opacity: 1; pointer-events: auto; }
  }

  .pie { background: var(--amarillo); padding: 3.5rem 0 3rem; }
  .pie__contenido { display: grid; justify-items: center; text-align: center; gap: 1.25rem; }
  .pie__logo { max-height: 130px; width: auto; }
  .pie__redes { display: flex; gap: 1rem; }
  .pie__redes a { color: var(--blanco); }
  .pie__redes a:hover { color: var(--azul-noche); }
  .pie__lema { font-family: var(--fuente-titulos); font-weight: 700; color: var(--blanco); margin: 0; font-size: clamp(1.1rem, 2.4vw, 1.4rem); max-width: 34ch; }
  .pie__legal { margin: 0; font-size: 0.95rem; font-weight: 400; color: var(--texto); }
  .pie__legal a { color: var(--violeta-oscuro); }
</style>
