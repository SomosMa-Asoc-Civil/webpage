---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaNoticia from '../../components/TarjetaNoticia.astro';

const noticias = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const descripcion = 'Últimas noticias sobre derechos de familias monomarentales, cuota alimentaria y políticas públicas en Argentina.';
---
<Base titulo="Noticias y recursos" descripcion={descripcion}>
  <section class="seccion">
    <div class="contenedor-angosto centrado">
      <h1 class="titulo">Noticias y recursos</h1>
      <p class="bajada">{descripcion}</p>
    </div>
    <div class="contenedor listado">
      {noticias.length === 0 ? (
        <p class="centrado">Todavía no hay noticias publicadas.</p>
      ) : (
        <div class="grilla grilla-3">{noticias.map((n) => <TarjetaNoticia noticia={n} />)}</div>
      )}
    </div>
  </section>
</Base>

<style>
  .titulo { font-size: clamp(2.4rem, 6vw, 4.2rem); }
  .bajada { font-size: 1.15rem; font-weight: 400; max-width: 46ch; margin-inline: auto; }
  .listado { margin-top: 3.5rem; }
  .listado .grilla { row-gap: 3.5rem; }
</style>
