---
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import Icono from '../components/Icono.astro';
import IconoRed from '../components/IconoRed.astro';
import datos from '../data/contacto.json';
import sitio from '../data/sitio.json';
import { parrafos } from '../lib/url';

const { faq, titulo, subtitulo, texto, formulario } = datos;
---
<Base titulo="Contacto" descripcion={texto}>
  <section class="contenedor faq">
    <h1 class="centrado faq__titulo">{faq.titulo}</h1>
    <div class="faq__lista">
      {faq.preguntas.map((q) => (
        <div class="faq__item">
          <span class="faq__icono"><Icono nombre="pregunta" size={34} /></span>
          <div>
            <h2 class="faq__pregunta">{q.pregunta}</h2>
            {parrafos(q.respuesta).map((p) => <p>{p}</p>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor grilla grilla-2">
      <div>
        <span class="antetitulo">Contacto | {sitio.nombre_completo}</span>
        <h2 class="hablemos">{titulo}...</h2>
        <p class="subtitulo">{subtitulo}</p>
        {parrafos(texto).map((p) => <p class="texto">{p}</p>)}
      </div>
      <ul class="datos">
        <li><Icono nombre="mail" size={20} /> <a href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
        {sitio.redes.map((r) => (
          <li>
            <IconoRed red={r.red} size={20} />
            <a href={r.url} target="_blank" rel="noopener">{r.red === 'linkedin' ? 'LinkedIn' : r.red === 'instagram' ? 'Instagram' : 'Web'}</a>
          </li>
        ))}
        <li><Icono nombre="ubicacion" size={20} /> {sitio.ubicacion}</li>
      </ul>
    </div>
  </section>

  <section class="seccion" style="padding-top:0">
    <div class="contenedor-angosto">
      <h2 class="centrado ayuda">{formulario.titulo}</h2>
      <div class="formulario-tarjeta">
        <Formulario
          id="form-contacto"
          asunto={formulario.asunto_mail}
          campos={[
            { nombre: 'nombre', etiqueta: 'Tu nombre', requerido: true, autocompletar: 'name' },
            { nombre: 'email', etiqueta: 'Tu correo electrónico', tipo: 'email', requerido: true, autocompletar: 'email' },
            { nombre: 'asunto', etiqueta: 'Asunto', requerido: true },
            { nombre: 'mensaje', etiqueta: 'Tu mensaje (opcional)', tipo: 'textarea' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .faq { background: var(--violeta-suave); padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 6vw, 6rem); margin-top: 1.5rem; }
  .faq__titulo { font-size: clamp(1.8rem, 3.4vw, 2.5rem); margin-bottom: 2.5rem; }
  .faq__lista { display: grid; gap: 2.5rem; max-width: 760px; margin-inline: auto; }
  .faq__item { display: flex; gap: 1.75rem; align-items: flex-start; }
  .faq__icono { flex: none; color: var(--violeta); margin-top: 0.5rem; }
  .faq__pregunta { font-size: 1.15rem; font-weight: 700; color: var(--violeta); margin-bottom: 0.35rem; }
  .faq__item p { font-size: 0.925rem; font-weight: 400; margin-bottom: 0; }

  .hablemos { font-size: clamp(2rem, 4vw, 2.6rem); margin-bottom: 0.5rem; }
  .subtitulo { font-family: var(--fuente-titulos); font-weight: 600; margin-bottom: 0.25rem; }
  .texto { font-family: var(--fuente-titulos); }
  .datos { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; align-content: center; font-family: var(--fuente-titulos); }
  .datos li { display: flex; align-items: center; gap: 0.9rem; color: var(--texto); }
  .datos :global(svg) { color: var(--violeta); flex: none; }
  .datos a { color: var(--texto); text-decoration: none; }
  .datos a:hover { color: var(--violeta); }
  .ayuda { font-size: 1.6rem; font-weight: 600; margin-bottom: 1.75rem; }
</style>
