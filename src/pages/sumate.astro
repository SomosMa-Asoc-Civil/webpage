---
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import datos from '../data/sumate.json';
import { url } from '../lib/url';

const { imagen, titulo, voluntariado, formulario } = datos;
const provincias = [
  'Buenos Aires', 'CABA', 'Catamarca', 'Chaco', 'Chubut', 'Córdoba', 'Corrientes', 'Entre Ríos', 'Formosa',
  'Jujuy', 'La Pampa', 'La Rioja', 'Mendoza', 'Misiones', 'Neuquén', 'Río Negro', 'Salta', 'San Juan',
  'San Luis', 'Santa Cruz', 'Santa Fe', 'Santiago del Estero', 'Tierra del Fuego', 'Tucumán',
];
---
<Base titulo="Sumate" descripcion={voluntariado.texto}>
  <section class="seccion">
    <div class="contenedor grilla grilla-2 alinear-centro">
      {imagen && <img class="imagen" src={url(imagen)} alt="" width="560" height="420" />}
      <div>
        <p class="titulo">{titulo}</p>
        <h1 class="subtitulo">{voluntariado.titulo}</h1>
        <p class="texto">{voluntariado.texto}</p>
        <ul class="lista">{voluntariado.areas.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion" style="padding-top:0" id="formulario">
    <div class="contenedor">
      <div class="formulario-tarjeta">
        <Formulario
          id="form-voluntariado"
          asunto={formulario.asunto_mail}
          boton="Enviar solicitud"
          campos={[
            { nombre: 'nombre', etiqueta: 'Nombre completo', requerido: true, autocompletar: 'name' },
            { nombre: 'email', etiqueta: 'Correo electrónico', tipo: 'email', requerido: true, autocompletar: 'email' },
            { nombre: 'telefono', etiqueta: 'Teléfono', tipo: 'tel', requerido: true, autocompletar: 'tel' },
            { nombre: 'provincia', etiqueta: 'Provincia', tipo: 'select', requerido: true, placeholder: 'Seleccioná una provincia', opciones: provincias },
            { nombre: 'areas', etiqueta: 'Área de interés', tipo: 'checkbox', requerido: true, opciones: ['Asistencia Legal', 'Comunicación', 'Trabajo territorial', 'Investigación', 'Administración', 'Otro'] },
            { nombre: 'disponibilidad', etiqueta: 'Disponibilidad horaria', tipo: 'checkbox', requerido: true, opciones: ['Mañana', 'Tarde', 'Noche', 'Fines de semana'] },
            { nombre: 'experiencia', etiqueta: 'Experiencia previa relevante', tipo: 'textarea' },
            { nombre: 'motivacion', etiqueta: '¿Por qué querés sumarte a MA?', tipo: 'textarea', requerido: true },
            { nombre: 'como_nos_conociste', etiqueta: '¿Cómo te enteraste de nosotras?', tipo: 'select', opciones: ['Redes sociales', 'Web', 'Amigos/Conocidos', 'Medios de comunicación', 'Otro'] },
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .imagen { width: 100%; max-width: 600px; justify-self: center; border-radius: 6px; object-fit: cover; }
  .titulo { font-family: var(--fuente-titulos); font-weight: 700; font-size: clamp(1.6rem, 3.4vw, 2.1rem); color: var(--violeta); text-transform: uppercase; margin: 0 0 0.5rem; }
  .subtitulo { font-size: clamp(2rem, 4.6vw, 2.6rem); font-weight: 500; text-transform: uppercase; margin-bottom: 1.75rem; }
  .texto { font-size: 17px; font-weight: 400; line-height: 1.85; margin: 0; }
  .lista { list-style: none; padding: 0; margin: 0; font-size: 17px; font-weight: 400; line-height: 1.85; }
  .lista li::before { content: '– '; }
  @media (max-width: 1023px) {
    .grilla-2 > div { width: 100%; max-width: 600px; justify-self: center; }
  }
</style>
