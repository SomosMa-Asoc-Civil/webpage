---
// Cada noticia se publica en la raíz, igual que en WordPress: /deudores-afuera/
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaNoticia from '../components/TarjetaNoticia.astro';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.draft);
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

interface Props {
  noticia: CollectionEntry<'noticias'>;
}

const { noticia } = Astro.props;
const { title, date, author, image, excerpt, categories } = noticia.data;
const { Content } = await render(noticia);

// Meta como en WordPress: ADMIN | 21 JUNIO 2026 | 4:20 PM
const zona = { timeZone: 'UTC' } as const;
const dia = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', ...zona })
  .format(date)
  .replace(/ de /g, ' ');
const tieneHora = date.getUTCHours() + date.getUTCMinutes() > 0;
const hora = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, ...zona }).format(date);

const otras = (await getCollection('noticias', ({ data, id }) => !data.draft && id !== noticia.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base titulo={title} descripcion={excerpt || title} imagen={image || undefined} tipo="article">
  <article class="seccion nota">
    <div class="nota__columna">
      <header class="nota__cabecera">
        <h1 class="nota__titulo">{title}</h1>
        {categories.length > 0 && (
          <p class="nota__categorias">{categories.map((c) => <span>{c}</span>)}</p>
        )}
        {image && <img class="nota__portada" src={url(image)} alt="" width="640" height="360" />}
        <p class="nota__meta">
          <span>{author}</span>
          <span class="nota__sep" aria-hidden="true">|</span>
          <time datetime={date.toISOString()}>{dia}</time>
          {tieneHora && (
            <>
              <span class="nota__sep" aria-hidden="true">|</span>
              <span>{hora}</span>
            </>
          )}
        </p>
      </header>

      <div class="prosa">
        <Content />
      </div>
    </div>
  </article>

  {otras.length > 0 && (
    <section class="seccion relacionadas">
      <div class="contenedor">
        <h2 class="titulo-seccion centrado">Seguí leyendo</h2>
        <div class="grilla grilla-3">{otras.map((n) => <TarjetaNoticia noticia={n} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  /* Columna de la nota como en el tema: 896 px de texto en escritorio, 688 en notebooks chicas,
     490 en tablets chicas y el ancho de la pantalla menos 25 px por lado en celulares */
  .nota__columna { width: 100%; margin-inline: auto; padding-inline: 25px; }
  @media (min-width: 576px) { .nota__columna { max-width: 540px; } }
  @media (min-width: 768px) { .nota__columna { max-width: 720px; } }
  @media (min-width: 992px) { .nota__columna { max-width: 738px; } }
  @media (min-width: 1200px) { .nota__columna { max-width: 946px; } }

  /* Título: h3 del tema con peso 600 y letter-spacing 2px */
  .nota__titulo { font-size: clamp(1.75rem, 4.5vw, 2.25rem); font-weight: 600; line-height: 1.35; letter-spacing: 1px; margin: 0 0 1rem; }
  .nota__categorias { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 30px; margin: 0 0 1.5rem; font-family: var(--fuente-titulos); font-size: 17px; line-height: 1.7; color: var(--rojo); }

  /* Imagen destacada: 16:9, recortada, sin bordes redondeados */
  .nota__portada { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--violeta-claro); }

  /* Meta: 12 px, mayúsculas, gris al 50 %, separadas por "|" */
  .nota__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 60px 0 60px;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(48, 47, 48, 0.5);
  }
  .nota__sep { padding-inline: 5px; }

  .relacionadas { background: var(--violeta-suave); }
</style>
