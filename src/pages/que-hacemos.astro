---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import datos from '../data/que-hacemos.json';
import { url } from '../lib/url';

const { titulo, intro, areas_titulo, areas, logros, cta } = datos;
const iconos = ['personas', 'codigo', 'balanza', 'editar'];
---
<Base titulo="Qué hacemos" descripcion={intro.join(' ')}>
  <section class="seccion">
    <div class="contenedor-angosto centrado">
      <h1 class="titulo">{titulo}</h1>
      {intro.map((p) => <p class="intro">{p}</p>)}
      <p class="areas__titulo">{areas_titulo}</p>
    </div>

    <div class="contenedor areas">
      {areas.map((a, i) => (
        <article class="tarjeta area">
          <span class="area__icono"><Icono nombre={iconos[i % iconos.length]} size={28} /></span>
          <div>
            <h3>{a.titulo}</h3>
            <ul>{a.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        </article>
      ))}
      <article class="tarjeta area area--logros">
        <span class="area__icono"><Icono nombre="check" size={28} /></span>
        <div>
          <h3>{logros.titulo}</h3>
          <ul>{logros.items.map((l) => <li>{l}</li>)}</ul>
        </div>
      </article>
    </div>
  </section>

  <section class="seccion" style="padding-top:0">
    <div class="contenedor">
      <a class="cta" href={url(cta.boton.url)}>
        <span class="cta__titulo">{cta.titulo} <Icono nombre="flecha" size={30} trazo={1.5} /></span>
        <span class="cta__texto">{cta.texto}</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .titulo { font-size: clamp(2rem, 4vw, 2.6rem); }
  .intro { font-size: 1.1rem; font-weight: 400; margin-bottom: 0.25rem; }
  .areas__titulo { font-family: var(--fuente-titulos); font-weight: 600; text-transform: uppercase; margin: 2rem 0 0; }

  .areas { display: grid; gap: 1.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); margin-top: 2.5rem; }
  .area { display: flex; gap: 2rem; align-items: flex-start; }
  .area--logros { grid-column: 1 / -1; justify-self: center; width: min(100%, 560px); }
  .area__icono {
    flex: none;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--amarillo);
    color: var(--blanco);
  }
  .area h3 { color: var(--azul-noche); text-transform: uppercase; font-size: 1.15rem; font-weight: 700; margin: 0.6rem 0 0.75rem; }
  .area ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-weight: 400; font-size: 0.975rem; }

  .cta {
    display: grid;
    gap: 1rem;
    max-width: 445px;
    padding: 3.5rem 3rem;
    background: var(--violeta);
    color: var(--blanco);
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta:hover { background: var(--violeta-oscuro); color: var(--blanco); }
  .cta__titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--fuente-titulos);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .cta__texto { font-weight: 400; }
</style>
