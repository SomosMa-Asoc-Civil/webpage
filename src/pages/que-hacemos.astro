---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import IconoKubio from '../components/IconoKubio.astro';
import datos from '../data/que-hacemos.json';
import { url } from '../lib/url';

const { titulo, intro, areas_titulo, areas, logros, cta } = datos;
const iconos = ['grupo', 'codigo', 'balanza', 'editar'] as const;
const tarjetas = [
  ...areas.map((a, i) => ({ ...a, icono: iconos[i % iconos.length] })),
  { titulo: logros.titulo, items: logros.items, icono: 'check' as const, logros: true },
];
---
<Base titulo="Qué hacemos" descripcion={intro.join(' ')}>
  <section class="seccion">
    <div class="contenedor-angosto centrado">
      <h1 class="titulo">{titulo}</h1>
      <div class="intro">{intro.map((p) => <p>{p}</p>)}</div>
      <p class="areas__titulo">{areas_titulo}</p>
    </div>

    <div class="contenedor areas">
      {tarjetas.map((a) => (
        <article class:list={['area', { 'area--logros': a.logros }]}>
          <span class="area__icono"><IconoKubio nombre={a.icono} size={40} /></span>
          <div>
            <h3 class="area__titulo">{a.titulo}</h3>
            <ul>{a.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="seccion" style="padding-top:0">
    <div class="contenedor">
      <a class="cta" href={url(cta.boton.url)}>
        <span class="cta__bloque">
          <span class="cta__titulo">{cta.titulo} <Icono nombre="flecha" size={26} trazo={1.5} /></span>
          <span class="cta__texto">{cta.texto}</span>
        </span>
        {cta.imagen && <img class="cta__imagen" src={url(cta.imagen)} alt="" loading="lazy" width="460" height="460" />}
      </a>
    </div>
  </section>
</Base>

<style>
  .titulo { font-weight: 700; font-size: clamp(2.6rem, 6vw, 3.4rem); line-height: 1.2; margin-bottom: 1.25rem; }
  .intro p { font-size: clamp(1.15rem, 2.4vw, 1.4rem); font-weight: 400; line-height: 1.55; margin: 0; }
  .areas__titulo { font-family: var(--fuente-titulos); font-weight: 600; font-size: clamp(1.15rem, 2.4vw, 1.4rem); text-transform: uppercase; margin: 2.5rem 0 0; }

  .areas { display: grid; gap: 1.75rem; margin-top: 2.5rem; }
  /* Valores tomados del CSS de Kubio: radio 5px, sombra 0 19px 38px rgba(0,0,0,.16) */
  .area {
    background: var(--blanco);
    border-radius: 5px;
    box-shadow: 0 19px 38px 0 rgba(0, 0, 0, 0.16);
    padding: 30px 20px 26px;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0;
  }
  /* Círculo de 60 px (ícono de 40 + 10 de aire), como en Kubio; al pasar el mouse se vuelve rojo */
  .area__icono {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    padding: 10px;
    border-radius: 50%;
    background: rgba(245, 183, 60, 0.8);
    color: var(--blanco);
    transition: background-color 1s ease;
  }
  .area:hover .area__icono { background: var(--rojo); }
  /* Título h4 del tema (Poppins 600, 1.25em) y texto del tema (Roboto 300, 16px, #302f30) */
  .area__titulo { color: var(--azul-noche); text-transform: uppercase; font-size: 1.25rem; line-height: 1.4; font-weight: 600; margin: 40px 0 10px; }
  .area ul { list-style: none; margin: 0; padding: 0; font-family: var(--fuente-texto); font-weight: 300; font-size: 1rem; line-height: 1.6; color: var(--texto); }

  /* Escritorio: dos columnas, ícono a la izquierda (como en Kubio) */
  @media (min-width: 1024px) {
    .areas { grid-template-columns: repeat(2, 1fr); }
    .area { grid-template-columns: auto 1fr; justify-items: start; align-items: start; text-align: left; column-gap: 2.5rem; padding: 2rem 2rem 2.25rem; }
    .area__titulo { margin: 0.6rem 0 10px; }
    .area--logros { grid-column: 1 / -1; justify-self: center; width: min(100%, 560px); }
  }

  .cta { display: grid; text-decoration: none; color: var(--blanco); }
  @media (min-width: 576px) { .cta { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .cta { grid-template-columns: 445px 445px; } }
  .cta__bloque { display: grid; align-content: center; gap: 10px; min-height: 180px; padding: 12%; background: var(--violeta); transition: background 0.3s; }
  .cta:hover .cta__bloque { background: var(--violeta-oscuro); }
  .cta__titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--fuente-titulos);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.35;
    text-transform: uppercase;
  }
  .cta__texto { font-size: 1.05rem; font-weight: 300; line-height: 1.6; }
  .cta__imagen { width: 100%; height: 100%; min-height: 240px; max-height: 300px; object-fit: cover; }
</style>
