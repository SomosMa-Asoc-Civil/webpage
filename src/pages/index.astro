---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import IconoRed from '../components/IconoRed.astro';
import inicio from '../data/inicio.json';
import { url, parrafos } from '../lib/url';

const { hero, cifras, instagram, alianzas } = inicio;
const [intro, ...resto] = parrafos(hero.texto);
const iconosCifras = ['institucion', 'personas'];
---
<Base>
  <!-- Portada: imagen a la izquierda, texto a la derecha -->
  <section class="seccion">
    <div class="contenedor grilla grilla-2 alinear-centro">
      {hero.imagen && (
        <img class="hero__imagen" src={url(hero.imagen)} alt="Integrantes de Monomarentales Argentina" width="560" height="560" />
      )}
      <div>
        <span class="antetitulo">{hero.antetitulo}</span>
        <h1 class="hero__titulo">{hero.titulo}</h1>
        {intro && <p class="hero__intro">{intro}</p>}
        {resto.map((p) => <p class="hero__texto">{p}</p>)}
        <div class="botones">
          {hero.botones.map((b) => <a class="boton" href={url(b.url)}>{b.texto}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Cifras que importan -->
  <section class="seccion cifras">
    <div class="contenedor">
      <h2 class="centrado cifras__titulo">{cifras.titulo}</h2>
      <div class="cifras__grilla">
        <div class="cifras__tarjeta">
          {cifras.items.map((c, i) => (
            <div class="cifra">
              <span class="cifra__icono"><Icono nombre={iconosCifras[i % 2]} size={34} trazo={1.6} /></span>
              <p class="cifra__dato">{c.dato}</p>
              <p class="cifra__texto">{c.texto}</p>
              {c.fuente && <p class="cifra__fuente">({c.fuente})</p>}
            </div>
          ))}
        </div>

        <div class="cifras__tarjeta cifras__tarjeta--roja">
          <h3>{cifras.destacado.titulo}</h3>
          <p class="cifras__pregunta">{cifras.destacado.subtitulo}</p>
          <a class="boton boton--durazno" href={url(cifras.destacado.boton.url)}>{cifras.destacado.boton.texto}</a>
        </div>

        <div class="cifras__tarjeta">
          <div class="cifra">
            <span class="cifra__icono"><Icono nombre="maletin" size={34} trazo={1.6} /></span>
            {cifras.destacado.lugar && <p class="cifra__lugar">{cifras.destacado.lugar}</p>}
            <p class="cifra__dato">{cifras.destacado.dato}</p>
            <p class="cifra__texto">{cifras.destacado.texto}</p>
            {cifras.destacado.fuente && <p class="cifra__fuente">({cifras.destacado.fuente})</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alianzas + Instagram -->
  <section class="seccion">
    <div class="contenedor grilla grilla-2 alinear-centro">
      <div>
        <h2>{alianzas.titulo}</h2>
        {parrafos(alianzas.texto).map((p) => <p>{p}</p>)}
      </div>
      <a class="tarjeta instagram" href={`https://www.instagram.com/${instagram.usuario}/`} target="_blank" rel="noopener">
        <span class="instagram__icono"><IconoRed red="instagram" size={44} /></span>
        <span class="instagram__titulo">{instagram.titulo}</span>
        <span class="instagram__usuario">@{instagram.usuario}</span>
        <span class="instagram__texto">{instagram.texto}</span>
      </a>
    </div>
    <div class="botones botones--centro">
      <a class="boton" href={url(alianzas.boton.url)}>{alianzas.boton.texto}</a>
    </div>
  </section>
</Base>

<style>
  .hero__imagen { width: 100%; max-width: 560px; justify-self: center; border-radius: var(--radio); object-fit: cover; }
  .hero__titulo { font-size: clamp(2rem, 4vw, 2.75rem); }
  .hero__intro { font-family: var(--fuente-titulos); font-weight: 600; font-size: 0.95rem; }
  .hero__texto { font-family: var(--fuente-titulos); font-size: 0.95rem; }

  .cifras__titulo { text-transform: uppercase; margin-bottom: 2.5rem; }
  .cifras__grilla { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .cifras__tarjeta {
    background: var(--gris-tarjeta);
    border-radius: 24px;
    padding: 2rem 1.5rem;
    display: grid;
    gap: 2.5rem;
    align-content: center;
    text-align: center;
  }
  .cifras__tarjeta--roja { background: var(--rojo); color: var(--blanco); gap: 1.25rem; justify-items: center; }
  .cifras__tarjeta--roja h3 { color: var(--blanco); font-weight: 700; font-size: clamp(1.6rem, 2.6vw, 2rem); margin: 0; }
  .cifras__pregunta { font-family: var(--fuente-titulos); font-weight: 600; font-size: 1.15rem; margin: 0; }
  .cifra p { margin: 0; font-family: var(--fuente-titulos); }
  .cifra__icono { display: inline-flex; color: var(--rojo); margin-bottom: 0.75rem; }
  .cifra__dato { font-weight: 700; font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.2; color: var(--texto); }
  .cifra__texto { margin-top: 0.5rem !important; font-size: 0.95rem; }
  .cifra__lugar { font-weight: 500; margin-bottom: 0.25rem !important; }
  .cifra__fuente { font-family: var(--fuente-texto) !important; font-style: italic; font-size: 0.78rem; margin-top: 0.75rem !important; }

  .instagram {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
    text-decoration: none;
    color: var(--texto);
    padding: 3rem 2rem;
    transition: transform 0.2s;
  }
  .instagram:hover { transform: translateY(-3px); color: var(--texto); }
  .instagram__icono { color: var(--violeta); margin-bottom: 0.5rem; }
  .instagram__titulo { font-family: var(--fuente-titulos); font-weight: 700; font-size: 1.4rem; }
  .instagram__usuario { font-family: var(--fuente-titulos); color: var(--violeta); font-weight: 500; }
  .instagram__texto { max-width: 34ch; }
</style>
