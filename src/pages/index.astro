---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import IconoRed from '../components/IconoRed.astro';
import inicio from '../data/inicio.json';
import feed from '../data/instagram.json';
import { url, formato } from '../lib/url';

const { hero, cifras, instagram, alianzas } = inicio;
const iconosCifras = ['institucion', 'personas'];
// Publicaciones de Instagram: las que trae GitHub Actions todos los días;
// si todavía no hay conexión, las que se carguen a mano en el CMS.
type Publicacion = { imagen: string; url: string; texto?: string };
const automaticas: Publicacion[] = (feed.publicaciones as Publicacion[]) ?? [];
const manuales: Publicacion[] = (instagram.publicaciones as Publicacion[]) ?? [];
const publicaciones = (automaticas.length ? automaticas : manuales).slice(0, feed.cantidad || 3);
const usuarioIG = feed.usuario || instagram.usuario;
---
<Base>
  <!-- Portada: imagen a la izquierda, texto a la derecha -->
  <section class="seccion">
    <div class="contenedor grilla grilla-2 alinear-centro">
      {hero.imagen && (
        <img class="hero__imagen" src={url(hero.imagen)} alt="Integrantes de Monomarentales Argentina" width="560" height="560" />
      )}
      <div>
        <span class="antetitulo">{hero.antetitulo}</span>
        <h1 class="hero__titulo">{hero.titulo}</h1>
        {formato(hero.texto).map((p) => <p class="hero__texto" set:html={p} />)}
        <div class="botones">
          {hero.botones.map((b) => <a class="boton" href={url(b.url)}>{b.texto}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Cifras que importan -->
  <section class="seccion cifras">
    <div class="contenedor">
      <h2 class="centrado cifras__titulo">{cifras.titulo}</h2>
      <div class="cifras__grilla">
        <div class="cifras__tarjeta">
          {cifras.items.map((c, i) => (
            <div class="cifra">
              <span class="cifra__icono"><Icono nombre={iconosCifras[i % 2]} size={40} trazo={1.5} /></span>
              <p class="cifra__dato" set:html={formato(c.dato).join('<br />')} />
              <p class="cifra__texto" set:html={formato(c.texto).join('<br />')} />
              {c.fuente && <p class="cifra__fuente">({c.fuente})</p>}
            </div>
          ))}
        </div>

        <div class="cifras__tarjeta cifras__tarjeta--roja">
          <h3>{cifras.destacado.titulo}</h3>
          <p class="cifras__pregunta">{cifras.destacado.subtitulo}</p>
          <a class="boton boton--durazno" href={url(cifras.destacado.boton.url)}>{cifras.destacado.boton.texto}</a>
        </div>

        <div class="cifras__tarjeta">
          <div class="cifra">
            <span class="cifra__icono"><Icono nombre="maletin" size={40} trazo={1.5} /></span>
            {cifras.destacado.lugar && <p class="cifra__lugar" set:html={formato(cifras.destacado.lugar).join('<br />')} />}
            <p class="cifra__dato">{cifras.destacado.dato}</p>
            <p class="cifra__texto" set:html={formato(cifras.destacado.texto).join('<br />')} />
            {cifras.destacado.fuente && <p class="cifra__fuente">({cifras.destacado.fuente})</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram -->
  <section class="seccion instagram">
    <div class="contenedor centrado">
      <a class="instagram__cuenta" href={`https://www.instagram.com/${usuarioIG}/`} target="_blank" rel="noopener">
        <span class="instagram__icono"><IconoRed red="instagram" size={34} /></span>
        <span class="instagram__usuario">@{usuarioIG}</span>
      </a>
      {publicaciones.length > 0 && (
        <div class="instagram__grilla">
          {publicaciones.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" aria-label={p.texto ? `Ver en Instagram: ${p.texto}` : 'Ver publicación en Instagram'}>
              <img src={url(p.imagen)} alt="" loading="lazy" width="360" height="360" />
            </a>
          ))}
        </div>
      )}
      <div class="botones botones--centro">
        <a class="boton" href={`https://www.instagram.com/${usuarioIG}/`} target="_blank" rel="noopener">Seguinos en Instagram</a>
      </div>
    </div>
  </section>

  <!-- Alianzas que transforman + mapa (en escritorio, texto a la izquierda y mapa a la derecha) -->
  <section class="seccion alianzas">
    <div class="contenedor alianzas__grilla">
      <div class="alianzas__texto texto-largo">
        <h2 class="alianzas__titulo">{alianzas.titulo}</h2>
        {formato(alianzas.texto).map((p) => <p set:html={p} />)}
      </div>
      {alianzas.mapa && (
        <div class="alianzas__mapa">
          <hr class="separador alianzas__linea" />
          <iframe src={alianzas.mapa} title="Mapa de alianzas estratégicas" loading="lazy" allowfullscreen></iframe>
        </div>
      )}
    </div>
    <div class="botones botones--centro">
      <a class="boton" href={url(alianzas.boton.url)}>{alianzas.boton.texto}</a>
    </div>
  </section>
</Base>

<style>
  .hero__imagen { width: 100%; max-width: 560px; justify-self: center; border-radius: var(--radio); object-fit: cover; }
  .hero__titulo { font-size: clamp(2rem, 4vw, 2.75rem); }
  .hero__texto { font-family: var(--fuente-titulos); font-size: 0.95rem; }

  .cifras__titulo { text-transform: uppercase; font-size: clamp(2rem, 4.5vw, 3.2rem); margin-bottom: 3rem; }
  .cifras__grilla { display: grid; gap: 30px; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 1023px) {
    .cifras__grilla { grid-template-columns: 1fr; max-width: 680px; margin-inline: auto; }
  }
  /* Tarjetas de Kubio: fondo #302f30 al 6 %, radio 30 px; la roja con alto mínimo de 350 px */
  .cifras__tarjeta {
    background: rgba(48, 47, 48, 0.06);
    border-radius: 30px;
    padding: 2.5rem 1.5rem;
    display: grid;
    gap: 2.5rem;
    align-content: center;
    text-align: center;
  }
  .cifras__tarjeta--roja { background: var(--rojo); color: var(--blanco); gap: 1.75rem; justify-items: center; padding-block: 3.5rem; min-height: 350px; }
  /* Botón "Conocer más": Open Sans 600, 12 px, durazno con texto rojo; hover violeta */
  .cifras__tarjeta--roja .boton { font-family: 'Open Sans', var(--fuente-texto); font-weight: 600; font-size: 12px; line-height: 1; letter-spacing: 1px; padding: 15px 30px; border-radius: 5px; }
  .cifras__tarjeta--roja .boton:hover { background: var(--violeta-oscuro); color: var(--blanco); }
  .cifras__tarjeta--roja h3 { color: var(--blanco); font-weight: 700; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.15; margin: 0; }
  .cifras__pregunta { font-family: var(--fuente-titulos); font-weight: 600; font-size: clamp(1.25rem, 2.6vw, 1.65rem); margin: 0; }
  .cifra p { margin: 0; font-family: var(--fuente-titulos); }
  .cifra__icono { display: inline-flex; color: var(--rojo); margin-bottom: 0.75rem; }
  .cifra__dato { font-weight: 700; font-size: clamp(2.2rem, 4.5vw, 3rem); line-height: 1.2; color: var(--texto); }
  .cifra__texto { margin-top: 1rem !important; font-size: clamp(1rem, 2vw, 1.3rem); line-height: 1.5; }
  .cifra__lugar { font-size: 1.15rem; margin-bottom: 0.5rem !important; }
  .cifra__fuente { font-family: var(--fuente-texto) !important; font-style: italic; font-size: 0.9rem; margin-top: 1rem !important; }
  @media (min-width: 1024px) {
    .cifra__dato { font-size: 2.1rem; }
    .cifra__texto { font-size: 1rem; }
    .cifras__tarjeta--roja h3 { font-size: 2.1rem; }
    .cifras__pregunta { font-size: 1.2rem; }
  }

  .instagram { padding-top: 1rem; }
  .instagram__cuenta { display: inline-grid; justify-items: center; gap: 0.75rem; color: var(--texto); text-decoration: none; }
  .instagram__icono {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 2px solid var(--texto);
    color: #d6249f;
  }
  .instagram__usuario { font-family: var(--fuente-titulos); font-size: clamp(1.3rem, 3vw, 1.9rem); }
  /* Como el feed de Spotlight: 3 columnas siempre, separación 16/12/8 px, esquinas redondeadas */
  .instagram__grilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 2rem; }
  @media (min-width: 768px) { .instagram__grilla { gap: 12px; } }
  @media (min-width: 1024px) { .instagram__grilla { gap: 16px; } }
  .instagram__grilla a { display: block; overflow: hidden; border-radius: 18%; }
  .instagram__grilla img { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.3s; }
  .instagram__grilla a:hover img { transform: scale(1.05); }

  .alianzas__texto { width: 100%; max-width: 620px; margin-inline: auto; }
  .alianzas__titulo { font-weight: 700; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.15; text-align: center; }
  .alianzas__mapa { width: 100%; max-width: 900px; margin: 2.5rem auto 0; }
  .alianzas__linea { margin-top: 0; border-top-color: var(--texto-suave); }
  .alianzas__mapa iframe { display: block; width: 100%; height: 480px; border: 0; border-radius: 15px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); }

  /* Escritorio: dos columnas como en Kubio */
  @media (min-width: 1024px) {
    .alianzas__grilla { display: grid; grid-template-columns: 1fr 1fr; column-gap: 50px; align-items: center; }
    .alianzas__texto { max-width: none; margin: 0; }
    .alianzas__titulo { text-align: left; font-size: 3.2rem; }
    .alianzas__mapa { max-width: none; margin: 0; }
    .alianzas__mapa iframe { height: 630px; }
  }
  .alianzas .botones { margin-top: 3.5rem; }
</style>
